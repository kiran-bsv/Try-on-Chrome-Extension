{
    "manifest_version" : 3,
    "name" : "crackeddev image selector",
    "version": "1.0",
    "description": "Select an image on the webpage and get its URL.",
    "permissions": ["tabs","activeTab", "scripting", "clipboardWrite"],
    "host_permissions": ["<all_urls>"],
    "background":{
        "service_worker" : "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "css":["content.css"]
        }
    ]
}